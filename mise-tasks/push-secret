#!/usr/bin/env bash
#MISE description="Send styles/Security/Infra.yml to CI as the VALE_SECURITY_INFRA secret"
#
# Ships the gitignored rule to CI. The runner cannot check out a file that is
# never committed, so the whole file rides in one secret. Re-run after every
# edit to the rule: nothing detects the drift, and CI keeps linting the old one.
set -euo pipefail

if [ ! -f styles/Security/Infra.yml ]; then
  echo "styles/Security/Infra.yml is missing. Run mise run setup first."
  exit 1
fi
gh secret set VALE_SECURITY_INFRA < styles/Security/Infra.yml
echo "VALE_SECURITY_INFRA updated from styles/Security/Infra.yml"
