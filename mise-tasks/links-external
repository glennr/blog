#!/usr/bin/env bash
#MISE description="External links in the named posts (default: every post not yet on master) still resolve"
#
# `mise run test` passes htmltest `-s`, so it never fetches an external link:
# a cited URL that 404s (a Fowler article did) got through the gate. A full
# htmltest run without `-s` takes four minutes and fails on sites that answer
# a bot with 403, so it stays out of `check`. This fetches only the links in
# the posts in hand, from their Markdown, before a post lands.
#
# A 403 or 429 is a bot wall, not a dead page, so it passes with a note.
# Usage: mise run links-external [content/posts/<post>.md ...]
set -euo pipefail

if [ "$#" -gt 0 ]; then
  files=("$@")
else
  mapfile -t files < <(git diff --name-only --diff-filter=AM master -- 'content/*.md' | grep -v '_index\.md$')
fi
[ "${#files[@]}" -gt 0 ] || { echo "No posts to check."; exit 0; }

status=0
while read -r file url; do
  code=$(curl -sL -o /dev/null -w '%{http_code}' --max-time 20 -A 'Mozilla/5.0 (links-external)' "$url") || code=000
  case "$code" in
    2??) ;;
    403 | 429) echo "$file: $code (bot wall, not checked) $url" ;;
    *) echo "$file: $code $url"; status=1 ;;
  esac
done < <(grep -oHP '\]\(\Khttps?://[^)\s]+|<\Khttps?://[^>\s]+(?=>)' "${files[@]}" |
  sed 's/:/ /' | grep -v ' https\?://glenn-roberts\.com' | sort -u)

[ "$status" -eq 0 ] && echo "External links resolve."
exit "$status"
