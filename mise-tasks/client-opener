#!/usr/bin/env bash
#MISE description="A post speaks generally: no unnamed 'we' or 'our app', and a client post never says whose app it is"
#MISE sources=["content/**", "test/client-opener/**", "mise-tasks/client-opener"]
#MISE outputs={ auto = true }
#
# I build several apps, for clients and for myself, so an unnamed "we",
# "our app" or "our team" leaves the reader asking who. A post describes the
# code or the case on its own, with "the app" for the app and "I" for what I
# did.
#
# Every post: no "we" (or its contractions), "our", "ours", "ourselves" or
# "us" in the title, the description or the prose, headings and callouts
# included. Fenced code, inline code, URLs and double-quoted text are
# skipped, so a quote can still say "we".
#
# A post marked `client: true` also never says whose app it is: no "an app
# I build for a client", "a client's app", "my client", "I'm building", "my
# app" or "the team".
#
# test/client-opener/fire/ and pass/ pin the cases, one trigger a file.
# test/client-opener/grandfathered lists published posts that predate the
# rule. They are skipped, and a listed post that no longer hits fails, so
# the list only shrinks.
set -euo pipefail

scan() {
  awk '
    BEGIN {
      we = "(^|[^[:alnum:]_])(we|our|ours|ourselves)([^[:alnum:]_]|$)"
      us = "(^|[^[:alnum:]_])us([^[:alnum:]_]|$)"
      own = "(^|[^[:alnum:]_])((a|my|our|the|for a) client(.s)?( [[:alnum:]-]+)? (app|application|codebase|project|system|product|team)|my clients?|a client.s|for (a|one of my) clients?|i.m building|i am building|(app|codebase|product|project) i (work on|build|maintain|look after)|my (app|codebase|product)|(the|my) team)([^[:alnum:]_]|$)"
    }
    function strip(s) {
      gsub(/`[^`]*`/, "", s)
      gsub(/\]\([^)]*\)/, "]", s)
      gsub(/https?:\/\/[^[:space:])>]*/, "", s)
      gsub(/"[^"]*"/, "", s)
      gsub(/“[^”]*”/, "", s)
      return s
    }
    function check(where, raw, s) {
      if (tolower(s) ~ we || s ~ us) printf "%s:%d: %s: we/our/us: %s\n", FILENAME, FNR, where, raw
      if (client && tolower(s) ~ own) printf "%s:%d: %s: whose app: %s\n", FILENAME, FNR, where, raw
    }
    FNR == 1 {
      fm = ($0 == "---"); fence = 0
      client = 0
      cmd = "grep -qx \"client: true\" \"" FILENAME "\""
      client = (system(cmd) == 0)
      if (fm) next
    }
    fm && $0 == "---" { fm = 0; next }
    fm {
      if ($0 ~ /^(title|description):/) {
        s = $0; sub(/^[a-z]+:[[:space:]]*/, "", s); sub(/^"/, "", s); sub(/"[[:space:]]*$/, "", s)
        gsub(/`[^`]*`/, "", s)
        check(substr($0, 1, index($0, ":") - 1), $0, s)
      }
      next
    }
    /^[[:space:]]*```/ { fence = !fence; next }
    fence { next }
    /^[[:space:]]*\{\{/ { next }
    { check("body", $0, strip($0)) }
  ' "$@"
}

status=0
for f in test/client-opener/fire/*.md; do
  [ -n "$(scan "$f")" ] || { echo "$f: did not fire"; status=1; }
done
for f in test/client-opener/pass/*.md; do
  hit=$(scan "$f")
  [ -z "$hit" ] || { echo "$hit (must not fire)"; status=1; }
done
[ "$status" -eq 0 ] || exit 1

mapfile -t old < <(grep -v '^[[:space:]]*\(#\|$\)' test/client-opener/grandfathered)
for f in "${old[@]}"; do
  [ -f "$f" ] || { echo "$f: grandfathered but missing; drop it from test/client-opener/grandfathered"; status=1; continue; }
  [ -n "$(scan "$f")" ] || { echo "$f: grandfathered but clean now; drop it from test/client-opener/grandfathered"; status=1; }
done
[ "$status" -eq 0 ] || exit 1

mapfile -t files < <(find content/posts -name '*.md' | sort | grep -vxF -f <(printf '%s\n' "${old[@]}"))
hits=$(scan "${files[@]}")
[ -z "$hits" ] || {
  printf '%s\n' "$hits"
  echo "Speak generally: describe the code or the case, 'the app' for the app, 'I' only for what you did. No unnamed 'we' or 'our', and no saying whose app it is."
  exit 1
}
echo "No unnamed 'we' or whose-app framing in ${#files[@]} post(s); ${#old[@]} grandfathered."
